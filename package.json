{
  "name": "eprx_uv1-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:studio": "prisma studio --url $(grep DATABASE_URL apps/api/.env | cut -d '=' -f2 | sed 's/\"//g')",
    "dev": "node scripts/update-ip.js && turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "sync-ip": "node scripts/update-ip.js",
    "start:railway": "npx prisma migrate deploy && node dist/apps/api/main.js",
    "android": "turbo run android",
    "ios": "turbo run ios"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.7.4",
    "prisma": "^7.3.0",
    "turbo": "^2.8.1",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "@types/react"
      ]
    },
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0"
    }
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "version": "1.0.0",
  "dependencies": {
    "axios": "^1.15.1",
    "resend": "^6.12.2"
  }
}
