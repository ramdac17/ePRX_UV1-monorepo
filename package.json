{
  "name": "eprx_uv1-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:studio": "prisma studio --url $(grep DATABASE_URL apps/api/.env | cut -d '=' -f2 | sed 's/\"//g')",
    "dev": "node scripts/update-ip.js && turbo run dev",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "sync-ip": "node scripts/update-ip.js",
    "postinstall": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "start:railway": "npx prisma migrate deploy && node dist/apps/api/main.js",
    "android": "turbo run android",
    "ios": "turbo run ios"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/sequelize": "^4.28.20",
    "prettier": "^3.7.4",
    "turbo": "^2.8.1",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "@types/react"
      ]
    },
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0"
    }
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.3.0",
    "@prisma/client": "^7.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cross-env": "^7.0.3",
    "express": "^4.22.1",
    "path": "^0.12.7",
    "prisma": "^7.3.0",
    "satori": "^0.26.0",
    "tsconfig-paths": "^4.2.0"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "version": "1.0.0"
}
